<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/AddSpecialization.css">
</head>
<body>
    <% if (deleted) { %>
        <h3><%= deleted %></h3>
    <% } %>

    <div>
        <a href="/admin">back</a>
    </div>
    <div>
        <a href="/admin/specialization/doctor/<%= specId %>/add">add doctor</a>
    </div>



    <div class="card-container">
        <% data.forEach(el => { %>
            <div class="card">
                <img src="/<%= el.imageUrl %>" alt="<%= el.name %>">
                <div class="card-body">
                    <h3><%= el.name %></h3>
                    <h4><%= el.Specialization.name %></h4>
                </div>
                <div>
                    <a href="/admin/specialization/delete/doctor/<%= specId %>/<%= el.id %>">
                        <button type="button">delete</button>
                    </a>
                
                </div>
            </div>
        <% }) %>
    </div>
    
</body>
</html>