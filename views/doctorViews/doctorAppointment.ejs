<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/doctorAppointment.css">
</head>
<body>
    <div>
        <div class="top-actions">
            <a href="/doctor" class="btn-link btn-back"> Back</a>
        </div>

        <h2 class="section-title"><%= data.name %></h2>

        <table class="data-table">
            <tr>
                <th>No.</th>
                <th>Patient Name</th>
                <th>Date of Birth</th>
                <th>Gender</th>
                <th>Appointment Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
            <% data.Appointments.forEach((el,i) => { %>
                <tr>
                    <td><%= i+1 %></td>
                    <td><%= el.User.Profile.fullName %></td>
                    <td><%= el.User.Profile.getBirthDate() %></td>
                    <td><%= el.User.Profile.gender %></td>
                    <td><%= el.getAppointmentDate() %></td>
                    <td>
                        <span class="status-badge status-<%= el.status.toLowerCase() %>">
                            <%= el.status %>
                        </span>
                    </td>
                    <td class="action-cell">
                        <a href="/doctor/appointment/done/<%= el.id %>/<%= data.id %>" class="link-view">
                            <button type="button">Done</button>
                        </a>
                    </td>
                </tr>
            <% }) %>
        </table>
    </div>
    
</body>
</html>